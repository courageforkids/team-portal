# ── Required ──
DATABASE_URL=postgres://user:password@host:5432/dbname   # Neon/Supabase "pooled" connection string works
APP_URL=https://team.teamcourageforkids.org               # used in invite/reset links and calendar feeds
CRON_SECRET=                                              # long random string (openssl rand -hex 32)

# ── File storage ── (local disk only works on a server with a persistent disk)
STORAGE_DRIVER=s3                 # s3 | local
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=cfk-portal-files        # keep the bucket PRIVATE — files are served only through the app
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# STORAGE_DIR=./.storage          # when STORAGE_DRIVER=local

# ── Email (optional; nothing is sent until an admin enables it in Settings → Email) ──
RESEND_API_KEY=

# ── Optional ──
DB_POOL_MAX=5
# LOGIN_IP_LIMIT=30   # sign-in attempts per IP per 15 min (raise if many members share one school network)
